#!/usr/bin/with-contenv bashio
# shellcheck shell=bash
#
# Runs when the service exits.
#
# Deliberately plain bash rather than the execlineb form used by some
# examples: `s6-test` is not on PATH in this base image, and a finish script
# that cannot spawn is noise in every log line. s6 restarts the service; the
# watchdog declared in config.yaml is what tells Home Assistant the app is
# unhealthy if it keeps failing.
if [[ "${1}" -ne 0 ]] && [[ "${1}" -ne 256 ]]; then
    bashio::log.warning "Android Timeline exited with code ${1}; s6 will restart it."
fi
